# Required for RAG, architecture analysis, developer actions, modification, and review.
GROQ_API_KEY=your_groq_api_key_here

# Optional: comma-separated permitted frontend origins. Leave blank for the
# included same-origin UI; set this if hosting a separate frontend.
REPOPILOT_ALLOWED_ORIGINS=

# Controlled cloned workspaces are removed when a session expires.
REPOPILOT_SESSION_TTL_SECONDS=3600

# Optional. Only needed for approved remote push / pull-request creation.
GITHUB_TOKEN=
